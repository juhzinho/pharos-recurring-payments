# Only needed if YOU run these steps yourself. The agent never needs the payer's key.
# PAYER_PRIVATE_KEY=0x…          # "sign": the payer signs their own schedule locally (or use any wallet + "attach")
# RELAYER_PRIVATE_KEY=0x…        # "tick --relay": an account that sends the due payment and pays its gas (moves no USDC of its own)
# PHAROS_RPC_URL=https://rpc.pharos.xyz
# PHAROS_RPC_CONCURRENCY=2
# ANVIL_BIN=                     # an Anvil binary for the fork demo (default: the npm package)
# FORK_PORT=8551
# PORT=3140                      # the local demo site
